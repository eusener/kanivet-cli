# Gerado pelo kanivet-cli. Não edite: este arquivo é reescrito a cada execução.

# Homebrew e ~/.local/bin no PATH
if ! command -v brew >/dev/null 2>&1; then
  for _kv_brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -x "$_kv_brew" ]; then
      eval "$("$_kv_brew" shellenv)"
      break
    fi
  done
  unset _kv_brew
fi
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export MANROFFOPT='-c'

# eza
if command -v eza >/dev/null 2>&1; then
  alias ll='eza -lah --git'
  alias ls='eza --icons=auto'
fi

# fzf
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi

# atuin
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# starship
if command -v starship >/dev/null 2>&1; then
  if [ -z "$STARSHIP_SHELL" ]; then
    eval "$(starship init zsh)"
  fi
fi

# zsh-syntax-highlighting
if command -v test >/dev/null 2>&1; then
  source ~/.zsh-sh
fi
